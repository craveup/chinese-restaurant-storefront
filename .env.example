# Legacy visual-reference configuration only.
# Never add a Crave API key or another private credential to browser variables.

# Optional: location label used while studying the local UI.
NEXT_PUBLIC_LOCATION_ID=your_craveup_location_id

# Optional: Organization slug for fetching expanded metadata. Leave blank to skip.
NEXT_PUBLIC_ORG_SLUG=

# Optional: Google Maps API key for embedding the map component.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
